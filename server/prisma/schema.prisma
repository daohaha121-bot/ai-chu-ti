generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Exam {
  id              String       @id @default(uuid())
  title           String
  description     String?
  durationMinutes Int          @default(0)
  passScore       Float        @default(60)
  totalScore      Float        @default(100)
  requiredFields  String       @default("[\"name\"]")
  examRules       String       @default("{\"maxSubmissions\":1,\"showAnswers\":true,\"preventCheating\":true,\"idleTimeoutSeconds\":60}")
  status          String       @default("active")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  questions       Question[]
  qrCodes         QRCode[]
  submissions     Submission[]
}

model Question {
  id         String   @id @default(uuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  type       String
  stem       String
  options    String?
  answer     String
  score      Float    @default(5)
  analysis   String?
  orderIndex Int      @default(0)
}

model QRCode {
  id         String    @id @default(uuid())
  codeKey    String    @unique
  title      String
  examId     String?
  exam       Exam?     @relation(fields: [examId], references: [id], onDelete: SetNull)
  isActive   Boolean   @default(true)
  expireAt   DateTime?
  scanCount  Int       @default(0)
  customLogo String?
  createdAt  DateTime  @default(now())
}

model Submission {
  id          String   @id @default(uuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  userInfo    String
  answers     String
  score       Float
  totalScore  Float
  isPassed    Boolean  @default(false)
  switchCount Int      @default(0)
  submittedAt DateTime @default(now())
}

model SystemConfig {
  id            String  @id @default("default")
  platformName  String  @default("AI 智能考试平台")
  logoUrl       String?
  watermarkText String?
  paymentConfig String?
}
