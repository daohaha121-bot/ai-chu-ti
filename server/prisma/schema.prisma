generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String    @id @default(uuid())
  openid      String?   @unique
  nickname    String    @default("创作者用户")
  avatar      String?
  role        String    @default("user") // "developer" 或 "user"
  freeQuota   Int       @default(3)      // 免费出题额度，默认赠送3次
  isVip       Boolean   @default(false)  // 是否是 VIP
  vipExpireAt DateTime?                  // VIP 到期时间
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  exams       Exam[]
  qrCodes     QRCode[]
  orders      Order[]
}

model Order {
  id            String    @id @default(uuid())
  orderNo       String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planType      String    // "vip_month", "vip_year", "quota_10"
  planName      String
  amount        Float
  status        String    @default("paid") // "pending", "paid"
  paymentMethod String    @default("wechat")
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
}

model Exam {
  id              String       @id @default(uuid())
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  durationMinutes Int          @default(0)
  passScore       Float        @default(60)
  totalScore      Float        @default(100)
  requiredFields  String       @default("[\"name\"]")
  examRules       String       @default("{\"maxSubmissions\":1,\"showAnswers\":true,\"preventCheating\":true,\"idleTimeoutSeconds\":60}")
  status          String       @default("active")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  questions       Question[]
  qrCodes         QRCode[]
  submissions     Submission[]
}

model Question {
  id         String   @id @default(uuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  type       String
  stem       String
  options    String?
  answer     String
  score      Float    @default(5)
  analysis   String?
  orderIndex Int      @default(0)
}

model QRCode {
  id         String    @id @default(uuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  codeKey    String    @unique
  title      String
  examId     String?
  exam       Exam?     @relation(fields: [examId], references: [id], onDelete: SetNull)
  isActive   Boolean   @default(true)
  expireAt   DateTime?
  scanCount  Int       @default(0)
  customLogo String?
  createdAt  DateTime  @default(now())
}

model Submission {
  id          String   @id @default(uuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  userInfo    String
  answers     String
  score       Float
  totalScore  Float
  isPassed    Boolean  @default(false)
  switchCount Int      @default(0)
  submittedAt DateTime @default(now())
}

model SystemConfig {
  id            String  @id @default("default")
  platformName  String  @default("AI 智能考试平台")
  logoUrl       String?
  watermarkText String?
  paymentConfig String?
  pricingPlans  String? // JSON: VIP 与额度套餐配置
}
